{
  "description": "При старте сессии: открытые workspace задач, задачи для продолжения, реестр занятости, напоминание о /duty:dispatch. Во всех сессиях: ворота постановки (поручение Agent без критерия готовности, условия остановки, справки и приоритетов и вопрос AskUserQuestion без «По документам:» отклоняются). В сессии агента задачи: запрет фонового ожидания у субагентов, сторожа остановки и запуска подзадач (agentId из ответа Agent) и запреты команд Bash (forbid)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" pre-tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/forbid.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendMessage|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" post-tool-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
