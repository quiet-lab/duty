{
  "description": "При старте сессии: открытые workspace задач, задачи для продолжения, очередь вопросов, реестр занятости, напоминание о /duty:dispatch. В сессии агента задачи: запрет фонового ожидания у субагентов, сторожа остановки и запреты команд Bash (forbid)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/forbid.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor|Bash|Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DUTY_ROLE\" = worker ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/task-guard.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
